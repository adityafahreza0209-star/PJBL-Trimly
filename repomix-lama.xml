<file path="login.css">
/* ==========================================================================
   TRIMLY OS — Login Portal
   Aesthetic: Light Editorial / Luxury Magazine
   Layout: Desktop Split-Screen / Mobile Single Column
   ========================================================================== */

:root {
  /* Strict Palette */
  --bg-arch-white: #FCFCFC;
  --bg-cool-gray: #F9FAFB;
  --forest-green: #14221D;
  --terracotta: #D96B43;
  --terracotta-hover: #c55b34;
  
  --border-light: rgba(20, 34, 29, 0.12);
  --border-medium: rgba(20, 34, 29, 0.3);
  
  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
  
  /* Utilities */
  --radius-sm: 4px;
  --radius-md: 8px;
  --transition-fast: 0.2s ease;
}

/* Base Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  height: 100vh; /* Full viewport height */
  font-family: var(--font-sans);
  background-color: var(--bg-arch-white);
  color: var(--forest-green);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow: hidden; /* Prevent page level scroll if form fits */
}

a {
  text-decoration: none;
  color: inherit;
}

.font-bold {
  font-weight: 600;
}

.text-terracotta {
  color: var(--terracotta);
}

/* ==================== LAYOUT ==================== */
.login-layout {
  display: flex;
  width: 100%;
  height: 100%;
}

/* Left Column: Visual Showcase */
.login-visual-col {
  display: none; /* Hidden on mobile by default */
}

/* Right Column: Form Wrapper */
.login-form-col {
  width: 100%;
  height: 100%;
  padding: 3rem 1.5rem;
  background-color: var(--bg-arch-white);
  overflow-y: auto; /* Allow scrolling on small screens */
  display: flex;
  flex-direction: column;
}

/* Pseudo-elements for safe flex centering */
.login-form-col::before,
.login-form-col::after {
  content: "";
  flex: 1 1 auto;
}

.form-wrapper {
  width: 100%;
  max-width: 440px;
  margin: 0 auto;
  flex: 0 0 auto;
}

/* ==================== FORM HEADER ==================== */
.mobile-brand-logo {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 2rem;
  display: block;
}

.form-title {
  font-family: var(--font-serif);
  font-size: 2.25rem;
  font-weight: 500;
  color: var(--forest-green);
  margin-bottom: 0.5rem;
  line-height: 1.2;
}

.form-subtitle {
  font-size: 0.95rem;
  color: rgba(20, 34, 29, 0.7);
  margin-bottom: 2.5rem;
}

/* ==================== FORM ELEMENTS ==================== */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-size: 0.85rem;
  color: var(--forest-green);
}

.form-input {
  width: 100%;
  padding: 1rem 1.25rem;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  background-color: var(--bg-arch-white);
  color: var(--forest-green);
  font-family: inherit;
  font-size: 1rem;
  transition: all var(--transition-fast);
}

.form-input:focus {
  outline: none;
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
}

.form-input::placeholder {
  color: rgba(20, 34, 29, 0.4);
}

/* Input Suffix (Subdomain) */
.input-suffix-group {
  display: flex;
  align-items: center;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  background-color: var(--bg-arch-white);
  transition: border-color var(--transition-fast);
}

.input-suffix-group:focus-within {
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
}

.input-suffix-group .form-input.has-suffix {
  border: none;
  box-shadow: none;
  border-radius: var(--radius-sm) 0 0 var(--radius-sm);
}

.input-suffix {
  padding: 1rem 1.25rem;
  background-color: var(--bg-cool-gray);
  color: rgba(20, 34, 29, 0.6);
  font-size: 0.95rem;
  border-left: 1px solid var(--border-light);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  white-space: nowrap;
}

/* Password Input */
.password-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-wrapper .pr-10 {
  padding-right: 3rem;
}

.btn-toggle-password {
  position: absolute;
  right: 1rem;
  background: none;
  border: none;
  color: rgba(20, 34, 29, 0.5);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  transition: color var(--transition-fast);
}

.btn-toggle-password:hover, .btn-toggle-password:focus {
  color: var(--forest-green);
  outline: none;
}

/* Form Controls (Checkbox & Forgot Password) */
.form-controls-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: -0.5rem;
}

.checkbox-container {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-size: 0.85rem;
  user-select: none;
}

.checkbox-container input {
  display: none;
}

.checkmark {
  width: 18px;
  height: 18px;
  border: 1px solid var(--border-medium);
  border-radius: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.checkbox-container input:checked ~ .checkmark {
  background-color: var(--forest-green);
  border-color: var(--forest-green);
}

.checkbox-container input:checked ~ .checkmark::after {
  content: "";
  width: 4px;
  height: 8px;
  border: solid var(--bg-arch-white);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
  margin-bottom: 2px;
}

.forgot-link {
  font-size: 0.85rem;
  color: var(--terracotta);
  font-weight: 500;
  transition: color var(--transition-fast);
}

.forgot-link:hover {
  text-decoration: underline;
  color: var(--terracotta-hover);
}

/* Submit Button */
.btn-submit {
  width: 100%;
  padding: 1.1rem;
  background-color: var(--terracotta);
  color: var(--bg-arch-white);
  border: none;
  border-radius: var(--radius-sm);
  font-family: inherit;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color var(--transition-fast);
  margin-top: 1rem;
}

.btn-submit:hover {
  background-color: var(--terracotta-hover);
}

/* Micro Note */
.micro-note {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: rgba(20, 34, 29, 0.6);
  background-color: var(--bg-cool-gray);
  padding: 0.75rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-light);
}

.micro-note svg {
  flex-shrink: 0;
  margin-top: 2px;
}

/* Back Link */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 3rem;
  font-size: 0.85rem;
  color: rgba(20, 34, 29, 0.7);
  transition: color var(--transition-fast);
}

.back-link:hover {
  color: var(--forest-green);
}

/* ==================== DESKTOP SPLIT SCREEN ==================== */
@media (min-width: 1024px) {
  
  .mobile-brand-logo {
    display: none;
  }
  
  .login-visual-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 45%;
    height: 100%;
    background-color: var(--forest-green);
    color: var(--bg-arch-white);
    padding: 3rem 4rem;
  }
  
  .login-form-col {
    width: 55%;
  }

  /* Visual Content */
  .brand-logo {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--bg-arch-white);
    margin-bottom: 4rem;
    display: inline-block;
  }
  
  .logo-dot {
    color: var(--terracotta);
  }

  .visual-headline {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 3rem;
    max-width: 90%;
  }

  .visual-quote {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(252, 252, 252, 0.8);
    max-width: 85%;
    border-left: 2px solid var(--terracotta);
    padding-left: 1.5rem;
  }

  .quote-author {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--bg-arch-white);
  }

  /* Visual Footer */
  .visual-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid rgba(252, 252, 252, 0.15);
    padding-top: 1.5rem;
  }

  .cloud-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(252, 252, 252, 0.7);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #4ade80; /* Subdued success green */
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.2);
    animation: pulse 2s infinite;
  }

  .version-tag {
    font-size: 0.75rem;
    font-family: monospace;
    color: rgba(252, 252, 252, 0.5);
  }
}

/* Animations */
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.4); }
  70% { box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
  100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
}
</file>

<file path="login.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Studio Sign In — Trimly OS</title>
  
  <!-- Google Fonts: Playfair Display (Serif), Geist (Sans-serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="login.css">
</head>
<body>

  <main class="login-layout">
    
    <!-- Left Column: Visual Showcase (Hidden on Mobile) -->
    <aside class="login-visual-col">
      <div class="visual-content">
        
        <!-- Logo -->
        <a href="index.html" class="brand-logo">
          Trimly<span class="logo-dot">.</span>
        </a>
        
        <!-- Headline -->
        <h1 class="visual-headline">The Dedicated Terminal for Premier Barbershop Operators</h1>
        
        <!-- Quote -->
        <blockquote class="visual-quote">
          "Mastery is found in the details of the craft, and precision is amplified by the system that supports it."
          <div class="quote-author font-bold">— The Artisan's Code</div>
        </blockquote>
      </div>

      <!-- Cloud Status -->
      <div class="visual-footer">
        <div class="cloud-status">
          <span class="status-dot"></span>
          <span>Cloud Server: Live & Operational</span>
        </div>
        <div class="version-tag">Trimly OS v2.4.0</div>
      </div>
    </aside>

    <!-- Right Column: Form Wrapper -->
    <section class="login-form-col">
      <div class="form-wrapper">
        
        <!-- Form Header -->
        <header class="form-header">
          <div class="mobile-brand-logo">Trimly<span class="text-terracotta">.</span></div>
          <h1 class="form-title">Studio Sign In</h1>
          <p class="form-subtitle">Enter your studio credentials to access the operation terminal and manage your appointments.</p>
        </header>

        <!-- Login Form -->
        <form class="auth-form" id="authForm" onsubmit="event.preventDefault();">
          
          <!-- Input 1: Studio Subdomain -->
          <div class="form-group">
            <label for="subdomain" class="font-bold">Studio Subdomain</label>
            <div class="input-suffix-group">
              <input type="text" id="subdomain" class="form-input has-suffix" placeholder="e.g. thenoble" required autocomplete="off">
              <span class="input-suffix">.trimly.com</span>
            </div>
          </div>

          <!-- Input 2: Email or WA -->
          <div class="form-group">
            <label for="userId" class="font-bold">Email or WhatsApp Number</label>
            <input type="text" id="userId" class="form-input" placeholder="admin@studio.com or 0812..." required>
          </div>

          <!-- Input 3: Password -->
          <div class="form-group">
            <label for="password" class="font-bold">Password</label>
            <div class="password-wrapper">
              <input type="password" id="password" class="form-input pr-10" placeholder="••••••••" required>
              <button type="button" class="btn-toggle-password" id="togglePassword" aria-label="Toggle password visibility">
                <svg id="icon-eye" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="icon-eye-off" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Controls Row -->
          <div class="form-controls-row">
            <label class="checkbox-container">
              <input type="checkbox" name="remember" id="remember">
              <span class="checkmark"></span>
              <span class="checkbox-text">Remember this device</span>
            </label>
            <a href="#" class="forgot-link">Forgot password?</a>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-submit">Sign In to Terminal</button>
          
          <!-- Micro Note -->
          <p class="micro-note">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            Akun Capster dikelola dan dibuat langsung oleh Admin Barbershop.
          </p>
        </form>

        <a href="index.html" class="back-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Return to Landing Page
        </a>
      </div>
    </section>

  </main>

  <script>
    // Password Toggle Logic
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const iconEye = document.getElementById('icon-eye');
    const iconEyeOff = document.getElementById('icon-eye-off');

    togglePassword.addEventListener('click', () => {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      
      if (type === 'text') {
        iconEye.style.display = 'none';
        iconEyeOff.style.display = 'block';
      } else {
        iconEye.style.display = 'block';
        iconEyeOff.style.display = 'none';
      }
    });
  </script>
</body>
</html>
