        <button class="btn-outline flex-1" onclick="closeModal('modalCancelBooking')">Kembali</button>
        <button class="btn-danger flex-1" onclick="closeModal('modalCancelBooking')">Ya, Batalkan Booking</button>
      </div>
    </div>
  </div>

  <!-- Modal: Edit Profile -->
  <div class="modal-overlay" id="modalEditCustomerProfile">
