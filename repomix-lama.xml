</head>
<body>

  <!-- Toast -->
  <div id="toast" class="toast">Review berhasil dikirim!</div>

  <!-- Header -->
  <header class="app-header">
    <h1 class="brand-logo">Trimly</h1>
    <button id="btnOpenEditProfile" class="btn-outline btn-sm">Edit Profil</button>
  </header>

  <main class="page-container">
    <div class="split-grid">
      <!-- Left: Digital Pass -->
      <section class="pass-column">
        <div class="digital-pass">
          <div class="pass-header">
            <h2 class="pass-title">Digital Pass</h2>
            <div class="pass-status">Confirmed</div>
          </div>
          
          <div class="pass-body">
            <div class="pass-client font-bold">Bagas Pratama</div>
            <div class="pass-service">Gentleman's Fade</div>
            
            <div class="pass-details-grid">
              <div class="detail-item">
                <span class="detail-label">Tanggal</span>
                <span class="detail-val">24 Nov 2024</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Waktu</span>
                <span class="detail-val">14:00 PM</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Capster</span>
                <span class="detail-val">Fajar A.</span>
              </div>
            </div>
            
            <div class="pass-code-container">
              <div class="pass-number">#TRM-9824</div>
              <div class="qr-placeholder">
                <!-- Mock QR Code SVG -->
                <svg viewBox="0 0 100 100" fill="currentColor" opacity="0.8">
                  <path d="M10,10 h20 v20 h-20 z M15,15 h10 v10 h-10 z M70,10 h20 v20 h-20 z M75,15 h10 v10 h-10 z M10,70 h20 v20 h-20 z M15,75 h10 v10 h-10 z M40,10 h20 v10 h-20 z M40,25 h10 v10 h-10 z M55,25 h15 v10 h-15 z M40,40 h15 v20 h-15 z M60,40 h10 v10 h-10 z M75,40 h15 v15 h-15 z M85,60 h5 v30 h-5 z M70,75 h10 v15 h-10 z M40,70 h20 v10 h-20 z M45,85 h15 v5 h-15 z M10,40 h20 v10 h-20 z M10,55 h10 v10 h-10 z M25,55 h10 v5 h-10 z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Right: Interactions -->
      <section class="info-column">
        
        <!-- Countdown -->
        <div class="card countdown-card">
          <div class="font-bold mb-2">Waktu Menuju Janji Temu</div>
          <div class="countdown-timer">02:45:10</div>
          <p class="text-muted">Harap datang 10 menit sebelum jadwal.</p>
