<file path="style.css">
/* ==========================================================================
   TRIMLY — B2B SaaS Landing Page
   Aesthetic: Light Editorial / Luxury Magazine
   ========================================================================== */

:root {
  /* Strict Color Palette */
  --bg-arch-white: #FCFCFC;
  --bg-cool-gray: #F9FAFB;
  --forest-green: #14221D;
  --forest-green-light: #1e332c;
  --forest-green-surface: #243d34;
  --terracotta: #D96B43;
  --terracotta-hover: #c55b34;
  
  --border-light: rgba(20, 34, 29, 0.1);
  --border-medium: rgba(20, 34, 29, 0.22);
  --border-dark: #14221D;

  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
  
  /* Layout */
  --container-max: 1200px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  
  /* Shadows */
  --shadow-subtle: 0 4px 20px -2px rgba(20, 34, 29, 0.05);
  --shadow-card: 0 12px 32px -8px rgba(20, 34, 29, 0.08);
  --shadow-mockup: 0 20px 45px -12px rgba(20, 34, 29, 0.18);
  
  --transition-fast: 0.2s ease;
}

/* Base Styles */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--bg-arch-white);
}

body {
  font-family: var(--font-sans);
  color: var(--forest-green);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition-fast);
}

img, svg {
  max-width: 100%;
  display: block;
}

.font-bold {
  font-weight: 600;
}

.text-terracotta {
  color: var(--terracotta);
}

.text-center {
  text-align: center;
}

.mt-8 {
  margin-top: 2rem;
}

.full-width {
  width: 100%;
  justify-content: center;
}

/* Layout Containers */
.section-container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 2rem;
}

/* Typography Scale (Strict Hierarchy) */
h1, h2, h3 {
  font-family: var(--font-serif);
  font-weight: 500;
  line-height: 1.1;
  color: var(--forest-green);
}

.hero-headline {
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}

.section-heading {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  letter-spacing: -0.01em;
  margin-bottom: 3rem;
  max-width: 800px;
}

.section-heading.text-center {
  margin-left: auto;
  margin-right: auto;
}

.feature-title, .tier-name, .step-title {
  font-size: 1.4rem;
  margin-bottom: 0.75rem;
}

.hero-subtext, .roi-desc, .faq-desc {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  color: rgba(20, 34, 29, 0.75);
  margin-bottom: 2rem;
}

/* ==================== BUTTONS (STRICT CONTRAST) ==================== */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-sm);
  border: 1.5px solid var(--forest-green);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.btn-primary:hover {
  background-color: var(--forest-green-light);
  border-color: var(--forest-green-light);
  transform: translateY(-1px);
}

.btn-primary.large {
  padding: 1rem 2rem;
  font-size: 1rem;
}

/* Outlined Button - 1.5px Solid High Contrast */
.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: transparent;
  color: var(--forest-green);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-sm);
  border: 1.5px solid var(--forest-green);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.btn-outline:hover {
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  transform: translateY(-1px);
}

.btn-outline.large {
  padding: 1rem 2rem;
  font-size: 1rem;
}

.btn-text {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--forest-green);
  padding: 0.5rem 0.75rem;
}

.btn-text:hover {
  color: var(--terracotta);
}

/* ==================== B2B NAVBAR ==================== */
.b2b-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(252, 252, 252, 0.95);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border-light);
}

.nav-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  max-width: var(--container-max);
  margin: 0 auto;
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-monogram {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.15rem;
  border-radius: 4px;
}

.brand-name {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.brand-dot {
  color: var(--terracotta);
}

.nav-links {
  display: flex;
  gap: 1.75rem;
}

.nav-item {
  font-size: 0.9rem;
  font-weight: 500;
  color: rgba(20, 34, 29, 0.75);
}

.nav-item:hover {
  color: var(--forest-green);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

/* ==================== HERO B2B ==================== */
.hero-b2b {
  padding: 5rem 0;
  background-color: var(--bg-arch-white);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
  align-items: center;
}

.hero-cta-group {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* ==================== HERO MOCKUP (TIGHTENED & LEGIBLE) ==================== */
.dashboard-mockup {
  background-color: var(--bg-cool-gray);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-mockup);
}

.mockup-header {
  display: flex;
  align-items: center;
  padding: 0.65rem 1rem;
  background-color: var(--bg-arch-white);
  border-bottom: 1px solid var(--border-light);
}

.window-controls {
  display: flex;
  gap: 6px;
}

.window-controls .ctrl {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}
.window-controls .ctrl.red { background-color: #EF4444; }
.window-controls .ctrl.yellow { background-color: #F59E0B; }
.window-controls .ctrl.green { background-color: #10B981; }

.window-title {
  flex-grow: 1;
  text-align: center;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 500;
  color: rgba(20, 34, 29, 0.5);
}

.live-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background-color: rgba(16, 185, 129, 0.12);
  color: #059669;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 20px;
  letter-spacing: 0.04em;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #10B981;
}

.mockup-body {
  display: grid;
  grid-template-columns: 140px 1fr;
  min-height: 380px;
}

.mockup-sidebar {
  background-color: var(--bg-arch-white);
  border-right: 1px solid var(--border-light);
  padding: 1rem 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.sidebar-item {
  font-size: 0.78rem;
  padding: 0.45rem 0.6rem;
  border-radius: var(--radius-sm);
  color: rgba(20, 34, 29, 0.7);
  font-weight: 500;
}

.sidebar-item.active {
  background-color: var(--bg-cool-gray);
  color: var(--forest-green);
  font-weight: 700;
  border-left: 2.5px solid var(--terracotta);
}

.mockup-content {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* KPI Cards Row */
.mockup-kpi-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.85rem;
}

.kpi-card {
  background-color: var(--bg-arch-white);
  padding: 0.9rem 1rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-subtle);
}

.kpi-card.highlight {
  border-color: var(--terracotta);
  background-color: #FFFDFB;
}

.kpi-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.78rem;
}

.kpi-trend {
  font-size: 0.7rem;
  font-weight: 700;
  color: #059669;
  background: rgba(16, 185, 129, 0.1);
  padding: 1px 6px;
  border-radius: 4px;
}

.badge-pill.dp-pill {
  font-size: 0.65rem;
  font-weight: 700;
  color: #FFFFFF;
  background-color: var(--terracotta);
  padding: 2px 6px;
  border-radius: 4px;
  letter-spacing: 0.03em;
}

.kpi-val {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  margin-top: 0.25rem;
  margin-bottom: 0.15rem;
}

.kpi-sub {
  font-size: 0.7rem;
  color: rgba(20, 34, 29, 0.6);
}

/* Schedule Matrix Card */
.mockup-schedule {
  background-color: var(--bg-arch-white);
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
}

.schedule-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.78rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-light);
  margin-bottom: 0.65rem;
}

.matrix-date {
  font-size: 0.7rem;
  color: rgba(20, 34, 29, 0.55);
}

.chair-matrix-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.chair-row {
  display: grid;
  grid-template-columns: 80px 1fr;
  align-items: center;
  gap: 0.65rem;
}

.chair-meta {
  display: flex;
  flex-direction: column;
}

.chair-id {
  font-size: 0.78rem;
  color: var(--forest-green);
}

.capster-sub {
  font-size: 0.68rem;
  color: rgba(20, 34, 29, 0.6);
}

.slot {
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm);
  font-size: 0.76rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  flex-wrap: wrap;
}

.slot.in-service {
  background-color: #F0FDF4;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.slot.booked-dp {
  background-color: var(--bg-cool-gray);
  border: 1px solid var(--border-light);
}

.slot.avail-slot {
  border: 1px dashed var(--border-medium);
  background-color: transparent;
}

.slot-text {
  font-weight: 500;
  color: rgba(20, 34, 29, 0.85);
  font-size: 0.74rem;
}

/* Prominent Mockup Badges */
.badge-status.in-service-badge {
  background-color: var(--forest-green);
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.66rem;
  padding: 2px 7px;
  border-radius: 3px;
}

.badge-status.booked-badge {
  background-color: rgba(20, 34, 29, 0.08);
  color: var(--forest-green);
  font-weight: 700;
  font-size: 0.66rem;
  padding: 2px 7px;
  border-radius: 3px;
}

.badge-status.avail-badge {
  background-color: transparent;
  color: #059669;
  font-weight: 600;
  font-size: 0.68rem;
}

.badge-dp.qris-badge {
  background-color: var(--terracotta);
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.68rem;
  padding: 2px 8px;
  border-radius: 3px;
  box-shadow: 0 2px 6px rgba(217, 107, 67, 0.3);
}

.badge-dp.va-badge {
  background-color: var(--forest-green-surface);
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.68rem;
  padding: 2px 8px;
  border-radius: 3px;
}

/* ==================== CORE FEATURES ==================== */
.features-b2b {
  padding: 6rem 0;
  background-color: var(--bg-cool-gray);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}

.feature-card {
  padding: 2.5rem;
  background-color: var(--bg-arch-white);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-subtle);
}

.feature-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(217, 107, 67, 0.1);
  color: var(--terracotta);
  border-radius: var(--radius-sm);
  margin-bottom: 1.5rem;
}

.feature-desc {
  color: rgba(20, 34, 29, 0.75);
}

/* ==================== 3-STEP WORKFLOW STEPPER ==================== */
.workflow-section {
  padding: 6rem 0;
  background-color: var(--bg-arch-white);
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
}

.workflow-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}

.workflow-card {
  padding: 2.5rem;
  background-color: var(--bg-cool-gray);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  display: flex;
  flex-direction: column;
  position: relative;
}

.step-numeral {
  font-family: var(--font-serif);
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--terracotta);
  line-height: 1;
  margin-bottom: 1.25rem;
}

.step-desc {
  color: rgba(20, 34, 29, 0.75);
  font-size: 0.95rem;
}

.step-desc code {
  background-color: rgba(20, 34, 29, 0.08);
  padding: 2px 5px;
  border-radius: 3px;
  font-family: inherit;
  font-weight: 600;
}

/* ==================== ROI CALCULATOR ==================== */
.roi-section {
  padding: 7rem 0;
  background-color: var(--bg-arch-white);
}

.roi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.roi-calculator-card {
  background-color: var(--bg-cool-gray);
  padding: 2.75rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-card);
}

.calc-group {
  margin-bottom: 1.75rem;
}

.calc-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.calc-val {
  font-weight: 600;
  color: var(--terracotta);
}

/* Custom Slider */
.trimly-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  background: var(--border-medium);
  border-radius: 3px;
  outline: none;
}

.trimly-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--forest-green);
  cursor: pointer;
  border: 2px solid var(--bg-arch-white);
  box-shadow: 0 2px 5px rgba(0,0,0,0.25);
}

.calc-result-box {
  margin-top: 2.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-medium);
}

.result-label {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.result-value {
  font-size: 2.4rem;
  font-family: var(--font-serif);
  font-weight: 700;
  color: var(--terracotta);
  margin-bottom: 0.35rem;
}

.result-subtext {
  font-size: 0.82rem;
  color: rgba(20, 34, 29, 0.65);
}

/* ==================== PRICING ==================== */
.pricing-section {
  padding: 7rem 0;
  background-color: var(--bg-cool-gray);
}

.billing-toggle-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  margin-bottom: 3.5rem;
}

.toggle-label {
  font-weight: 600;
  color: rgba(20, 34, 29, 0.5);
  cursor: pointer;
  transition: color var(--transition-fast);
}

.toggle-label.active {
  color: var(--forest-green);
}

.save-badge {
  background-color: rgba(217, 107, 67, 0.12);
  color: var(--terracotta);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  font-weight: 700;
  margin-left: 8px;
}

.billing-toggle {
  width: 54px;
  height: 30px;
  background-color: var(--forest-green);
  border-radius: 15px;
  border: none;
  position: relative;
  cursor: pointer;
  padding: 3px;
}

.toggle-knob {
  display: block;
  width: 24px;
  height: 24px;
  background-color: var(--bg-arch-white);
  border-radius: 50%;
  transition: transform var(--transition-fast);
  transform: translateX(24px); /* Default active state (Annually) */
}

.billing-toggle[aria-pressed="true"] .toggle-knob {
  transform: translateX(0); /* Monthly */
}

.pricing-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  max-width: 920px;
  margin: 0 auto;
}

.pricing-card {
  background-color: var(--bg-arch-white);
  padding: 3rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-card);
  position: relative;
  display: flex;
  flex-direction: column;
}

.pricing-card.popular {
  border: 2px solid var(--terracotta);
}

.popular-badge {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--terracotta);
  color: var(--bg-arch-white);
  padding: 4px 16px;
  border-radius: 12px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.tier-desc {
  color: rgba(20, 34, 29, 0.75);
  min-height: 3rem;
  margin-bottom: 1.5rem;
}

.tier-price {
  font-family: var(--font-serif);
  display: flex;
  align-items: flex-start;
  gap: 4px;
  margin-bottom: 0.25rem;
}

.tier-price .currency {
  font-size: 1.25rem;
  margin-top: 0.5rem;
}

.tier-price .amount {
  font-size: 2.8rem;
  font-weight: 700;
}

.tier-price .period {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: rgba(20, 34, 29, 0.55);
  margin-top: 1.4rem;
}

.tier-billing-note {
  font-size: 0.82rem;
  color: rgba(20, 34, 29, 0.6);
  margin-bottom: 2rem;
}

.feature-list {
  list-style: none;
  margin-top: 2rem;
}

.feature-list li {
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border-light);
  font-size: 0.92rem;
}

.feature-list li:last-child {
  border-bottom: none;
}

/* ==================== FAQ ==================== */
.faq-section {
  padding: 7rem 0;
  background-color: var(--bg-arch-white);
}

.faq-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 4rem;
}

.faq-accordion {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1px solid var(--border-light);
}

.faq-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 0;
  background: none;
  border: none;
  color: var(--forest-green);
  font-size: 1.1rem;
  font-family: var(--font-sans);
  cursor: pointer;
  text-align: left;
}

.faq-icon {
  font-size: 1.4rem;
  color: var(--terracotta);
  transition: transform var(--transition-fast);
}

.faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-fast);
  color: rgba(20, 34, 29, 0.75);
}

.faq-item.active .faq-content {
  max-height: 220px;
  padding-bottom: 1.5rem;
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
}

/* ==================== FOOTER ==================== */
.b2b-footer {
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  padding: 5rem 0 2rem;
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 4rem;
  margin-bottom: 4rem;
}

.footer-brand-col .brand-name {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.footer-brand-col p {
  color: rgba(252, 252, 252, 0.75);
  max-width: 300px;
}

.footer-links-col {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.footer-links-col a {
  color: rgba(252, 252, 252, 0.75);
  font-size: 0.92rem;
}

.footer-links-col a:hover {
  color: var(--bg-arch-white);
}

.footer-bottom {
  border-top: 1px solid rgba(252, 252, 252, 0.12);
  padding-top: 2rem;
  text-align: center;
  color: rgba(252, 252, 252, 0.55);
  font-size: 0.85rem;
}

/* ==================== RESPONSIVE ==================== */
@media (max-width: 1024px) {
  .hero-grid, .faq-grid {
    grid-template-columns: 1fr;
  }
  
  .roi-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  
  .workflow-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .nav-links {
    display: none;
  }
  
  .features-grid, .pricing-grid {
    grid-template-columns: 1fr;
  }
  
  .footer-top {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
