<file path="capster.css">
:root {
  --white: #FCFCFC;
  --cool-gray: #F9FAFB;
  --cool-gray-border: #E5E7EB;
  --forest-green: #14221D;
  --forest-green-muted: #4B5563;
  --terracotta: #D96B43;
  --success-green: #10B981;
  
  --font-sans: 'Geist', 'Outfit', sans-serif;
  --font-serif: 'Playfair Display', serif;
  
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-fab: 0 10px 15px -3px rgba(217, 107, 67, 0.4);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background-color: #E5E7EB; 
  color: var(--forest-green);
  font-family: var(--font-sans);
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Utilities */
.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.text-sm { font-size: 0.875rem; }
.text-muted { color: var(--forest-green-muted); }
.text-success { color: var(--success-green); }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mt-2 { margin-top: 8px; }
.w-100 { width: 100%; }

/* App Frame */
.capster-app-frame {
  width: 100%;
  max-width: 480px;
  height: 100vh;
  background-color: var(--cool-gray);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

@media (min-width: 768px) {
  .capster-app-frame {
    height: 90vh;
    max-height: 850px;
    border-radius: 24px;
    border: 8px solid var(--white);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
}

.app-content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 100px;
}

/* Header */
.capster-header {
  background-color: var(--white);
  padding: 24px 20px 20px;
  border-bottom: 1px solid var(--cool-gray-border);
  cursor: pointer;
  transition: background-color 0.2s;
}
.capster-header:hover {
  background-color: #F3F4F6;
}

.profile-group {
  display: flex;
  align-items: center;
  gap: 16px;
}

.avatar-wrap {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid var(--cool-gray-border);
  flex-shrink: 0;
}
.avatar-img { width: 100%; height: 100%; object-fit: cover; }

.profile-info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.capster-name {
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.2;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--forest-green-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border-radius: 4px;
  transition: all 0.2s;
}
.btn-icon:hover {
  background-color: var(--cool-gray-border);
  color: var(--forest-green);
}

.status-toggle-group {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
  color: var(--forest-green-muted);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #D1D5DB;
}
.status-dot.active {
  background-color: var(--success-green);
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
}

.toggle-switch {
  margin-left: auto;
  width: 40px;
  height: 22px;
  border-radius: 11px;
  background-color: #E5E7EB;
  border: none;
  position: relative;
  cursor: pointer;
  transition: all 0.2s;
}
.toggle-switch.active { background-color: var(--success-green); }
.toggle-knob {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background-color: var(--white);
  transition: transform 0.2s;
  box-shadow: var(--shadow-sm);
}
.toggle-switch.active .toggle-knob { transform: translateX(18px); }

/* Main Content */
.capster-main-content {
  padding: 20px;
}

/* Metrics */
.metrics-card {
  background-color: var(--forest-green);
  color: var(--white);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
  box-shadow: var(--shadow-md);
}

.metric-block { flex: 1; }
.metric-block.align-right { text-align: right; }

.metric-label {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.metric-value {
  font-size: 1.5rem;
  font-weight: 700;
}
.cuts-value { font-size: 1.25rem; }

.metric-divider {
  width: 1px;
  height: 32px;
  background-color: rgba(255, 255, 255, 0.15);
  margin: 0 16px;
}

/* Roster Section */
.section-title {
  font-size: 1.125rem;
  font-weight: 700;
  margin-bottom: 20px;
}

.timeline-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.timeline-item {
  display: flex;
  gap: 16px;
}

.time-col {
  width: 50px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 14px;
}

.time-text {
  font-size: 1rem;
  color: var(--forest-green);
  line-height: 1;
}

.time-period {
  font-size: 0.75rem;
  color: var(--forest-green-muted);
  font-weight: 500;
  margin-top: 2px;
}

.card-col {
  flex: 1;
}

.appt-card {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 12px;
  padding: 16px;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.clickable-card {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.clickable-card:active {
  transform: scale(0.98);
}

.appt-card.active-card {
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
}

.timeline-item.completed .time-text,
.timeline-item.completed .time-period {
  color: #9CA3AF;
}
.timeline-item.completed .appt-card {
  background-color: #F3F4F6;
  border-color: transparent;
  opacity: 0.8;
}

.appt-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 6px;
}

.client-name {
  font-size: 1.05rem;
  color: var(--forest-green);
}

.appt-service {
  font-size: 0.875rem;
  color: var(--forest-green-muted);
}

/* Badges */
.badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 99px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.badge-gray {
  background-color: #E5E7EB;
  color: #4B5563;
}
.badge-green {
  background-color: #DCFCE7;
  color: #166534;
}
.badge-orange {
  background-color: #FFEDD5;
  color: #C2410C;
}

/* Buttons */
.btn-primary {
  background-color: var(--forest-green);
  color: var(--white);
  border: none;
  padding: 14px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  font-family: var(--font-sans);
  transition: background-color 0.2s;
}
.btn-primary:active { background-color: #0f1a16; }

.btn-terracotta {
  background-color: var(--terracotta);
  color: var(--white);
  border: none;
  padding: 14px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  font-family: var(--font-sans);
  transition: background-color 0.2s;
}
.btn-terracotta:active { background-color: #c05c36; }

.btn-outline {
  background-color: transparent;
  color: var(--forest-green);
  border: 1px solid var(--forest-green);
  padding: 14px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  font-family: var(--font-sans);
  transition: background-color 0.2s;
}
.btn-outline:active { background-color: rgba(20, 34, 29, 0.05); }

.btn-secondary {
  background-color: var(--cool-gray-border);
  color: var(--forest-green);
  border: none;
  padding: 10px 16px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  font-family: var(--font-sans);
  transition: background-color 0.2s;
}
.btn-secondary:active { background-color: #D1D5DB; }

/* FAB */
.fab-leave-request {
  position: absolute;
  bottom: 24px;
  right: 24px;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background-color: var(--terracotta);
  color: var(--white);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  cursor: pointer;
  z-index: 50;
  transition: transform 0.2s, box-shadow 0.2s;
}
.fab-leave-request:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-sm);
}

/* Modals & Overlays */
.modal-overlay, .drawer-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(20, 34, 29, 0.5);
  backdrop-filter: blur(2px);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease-in-out;
}
.modal-overlay.active, .drawer-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.modal-content {
  background-color: var(--white);
  width: 100%;
  border-radius: 20px;
  padding: 24px;
  transform: translateY(20px) scale(0.95);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--shadow-lg);
  max-height: 90vh;
  overflow-y: auto;
}
.modal-overlay.active .modal-content {
  transform: translateY(0) scale(1);
}

.modal-header, .drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.modal-title, .drawer-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--forest-green);
}
.btn-close {
  background: none;
  border: none;
  font-size: 1.25rem;
  line-height: 1;
  padding: 4px;
  cursor: pointer;
  color: var(--forest-green-muted);
}

/* Forms & Inputs Strict Styling */
.form-group { margin-bottom: 16px; }
.form-group label {
  display: block;
  font-size: 0.875rem;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--forest-green);
}

.form-control {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  background-color: var(--white);
  color: var(--forest-green);
  transition: border-color 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}

/* Specific adjustment for Date input */
input[type="date"].form-control {
  min-height: 42px;
}

/* Custom Select Dropdown */
select.form-control.custom-select {
  appearance: none;
  -webkit-appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2314221D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 14px center;
  background-size: 16px;
  padding: 10px 36px 10px 14px;
}

.form-control:focus {
  outline: none;
  border-color: var(--terracotta);
  box-shadow: 0 0 0 3px rgba(217, 107, 67, 0.1);
}

/* Skill Tags / Pills */
.skill-tags { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 8px; 
  margin-bottom: 12px; 
}
.skill-tag {
  background-color: #F3F4F6;
  border: 1px solid var(--cool-gray-border);
  color: var(--forest-green);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}
.remove-tag {
  background: none;
  border: none;
  font-size: 1.125rem;
  cursor: pointer;
  color: var(--forest-green-muted);
  line-height: 1;
  padding: 0;
  display: flex;
  align-items: center;
  transition: color 0.2s;
}
.remove-tag:hover { color: var(--terracotta); }

.add-skill-group { 
  display: flex; 
  gap: 8px; 
  align-items: center;
}
.form-control-sm {
  padding: 6px 12px;
  min-height: 34px;
  font-size: 0.875rem;
  flex: 1;
}
.btn-sm {
  padding: 6px 16px;
  font-size: 0.875rem;
  min-height: 34px;
}

/* Drawer Specifics */
.drawer-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background-color: var(--white);
  border-radius: 24px 24px 0 0;
  padding: 12px 24px 32px;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -10px 25px rgba(0,0,0,0.1);
  max-height: 90vh;
  overflow-y: auto;
}
.drawer-overlay.active .drawer-content {
  transform: translateY(0);
}
.drawer-drag-handle {
  width: 40px;
  height: 5px;
  background-color: #D1D5DB;
  border-radius: 3px;
  margin: 0 auto 20px;
}

.client-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 4px;
}
.client-detail-name {
  font-size: 1.25rem;
  font-weight: 700;
}
.client-detail-time {
  font-size: 0.875rem;
  color: var(--forest-green-muted);
  margin-bottom: 20px;
}
.info-box {
  background-color: var(--cool-gray);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid var(--cool-gray-border);
}
.payment-box {
  background-color: #F8FAFC;
  border-color: #E2E8F0;
}
.box-title {
  font-size: 0.875rem;
  font-weight: 700;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--forest-green-muted);
}
.info-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.875rem;
}
.info-label { color: var(--forest-green-muted); }
.info-value { text-align: right; max-width: 65%; line-height: 1.4; }
</file>

