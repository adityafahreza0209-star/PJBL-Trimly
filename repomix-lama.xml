          <input type="email" class="form-control" value="bagas.pratama@email.com">
        </div>
        <div class="form-group">
          <label>Ubah Password</label>
          <input type="password" class="form-control" placeholder="Masukkan password baru">
        </div>
      </div>
      <div class="modal-footer mt-4">
        <button class="btn-primary w-100" onclick="closeModal('modalEditCustomerProfile')">Simpan Perubahan Profil</button>
      </div>
    </div>
  </div>

  <script src="ticket.js"></script>
</body>
</html>
