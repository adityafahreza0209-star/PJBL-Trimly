<file path="admin-settings.css">
:root {
  --white: #FFFFFF;
  --cool-gray: #F9FAFB;
  --cool-gray-hover: #F3F4F6;
  --cool-gray-border: #E5E7EB;
  
  --forest-green: #14221D;
  --forest-green-muted: #4B5563;
  --forest-green-light: #6B7280;
  
  --terracotta: #D96B43;
  --terracotta-hover: #C55B34;
  
  --font-sans: 'Outfit', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background-color: var(--cool-gray);
  color: var(--forest-green-muted);
  font-family: var(--font-sans);
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
}

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.text-dark { color: var(--forest-green); }
.text-right { text-align: right; }

.admin-layout {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* Sidebar */
.admin-sidebar {
  width: 260px;
  background-color: var(--forest-green);
  color: var(--white);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sidebar-brand {
  height: 70px;
  display: flex;
  align-items: center;
  padding: 0 24px;
  gap: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.brand-monogram {
  width: 32px;
  height: 32px;
  background-color: var(--terracotta);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1.1rem;
}

.brand-name { font-size: 1.1rem; letter-spacing: 0.05em; }

.sidebar-nav {
  flex: 1;
  padding: 24px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-item {
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  padding: 10px 12px;
  border-radius: 6px;
  transition: all 0.2s;
  font-weight: 500;
}

.nav-item:hover {
  color: var(--white);
  background-color: rgba(255, 255, 255, 0.05);
}

.nav-item.active {
  color: var(--white);
  background-color: rgba(255, 255, 255, 0.1);
}

.sidebar-footer {
  padding: 20px 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.5);
}

/* Main Area */
.admin-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Topbar */
.admin-topbar {
  height: 70px;
  background-color: var(--white);
  border-bottom: 1px solid var(--cool-gray-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  flex-shrink: 0;
}

.page-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--forest-green);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.studio-badge {
  background-color: var(--cool-gray);
  padding: 6px 12px;
  border-radius: 6px;
  border: 1px solid var(--cool-gray-border);
  font-size: 0.85rem;
  color: var(--forest-green);
}

/* Buttons */
.btn-outline-dark {
  background: transparent;
  border: 1px solid var(--cool-gray-border);
  padding: 8px 16px;
  border-radius: 6px;
  color: var(--forest-green);
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s;
}
.btn-outline-dark:hover { background: var(--cool-gray-hover); }

.btn-primary {
  background-color: var(--terracotta);
  color: var(--white);
  border: none;
  padding: 10px 20px;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}
.btn-primary:hover { background-color: var(--terracotta-hover); }

.btn-text {
  background: transparent;
  border: none;
  color: var(--terracotta);
  font-weight: 600;
  cursor: pointer;
}
.btn-text:hover { text-decoration: underline; }

/* Main Content */
.admin-content {
  flex: 1;
  padding: 32px;
  overflow-y: auto;
}

/* Tabs */
.tabs-header {
  display: flex;
  gap: 32px;
  border-bottom: 1px solid var(--cool-gray-border);
  margin-bottom: 32px;
}

.tab-btn {
  background: transparent;
  border: none;
  padding: 0 0 12px 0;
  font-size: 1rem;
  font-weight: 500;
  color: var(--forest-green-light);
  cursor: pointer;
  position: relative;
}

.tab-btn.active {
  color: var(--forest-green);
  font-weight: 700;
}

.tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: var(--forest-green);
}

/* Section */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.section-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--forest-green);
}

/* Data Table */
.card-container {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  overflow: hidden;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.data-table th, .data-table td {
  padding: 16px 24px;
  border-bottom: 1px solid var(--cool-gray-border);
}

.data-table th {
  background-color: var(--cool-gray);
  color: var(--forest-green-muted);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.data-table tbody tr {
  transition: background-color 0.15s;
}

.data-table tbody tr:hover {
  background-color: var(--cool-gray);
}

.badge-gray {
  background-color: var(--cool-gray-hover);
  color: var(--forest-green-muted);
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 600;
}

/* Side Drawer */
.drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(20, 34, 29, 0.4);
  backdrop-filter: blur(2px);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}
.drawer-overlay.open { opacity: 1; visibility: visible; }

.side-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 400px;
  height: 100vh;
  background-color: var(--white);
  z-index: 101;
  box-shadow: -4px 0 24px rgba(0,0,0,0.1);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}
.side-drawer.open { transform: translateX(0); }

.drawer-header {
  padding: 24px;
  border-bottom: 1px solid var(--cool-gray-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--forest-green);
}

.btn-close {
  background: transparent;
  border: none;
  color: var(--forest-green-light);
  cursor: pointer;
  padding: 4px;
}
.btn-close:hover { color: var(--forest-green); }

.drawer-body {
  flex: 1;
  padding: 24px;
  overflow-y: auto;
}

.form-layout {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-label {
  font-size: 0.9rem;
  color: var(--forest-green);
}

.form-input {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 6px;
  font-family: inherit;
  font-size: 0.95rem;
  color: var(--forest-green);
  transition: border-color 0.2s;
}
.form-input:focus {
  outline: none;
  border-color: var(--forest-green);
}

.drawer-footer {
  padding: 24px;
  border-top: 1px solid var(--cool-gray-border);
  display: flex;
  gap: 12px;
}

.block-w { flex: 1; }
/* Typography overrides for Strict UI rules */
.drawer-title, .page-title, .section-title {
  font-family: 'Playfair Display', serif;
}
</file>

