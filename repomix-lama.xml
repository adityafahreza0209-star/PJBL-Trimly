        </div>
        
        <div class="font-bold mt-4 mb-2">Pilih Tanggal Baru</div>
        <div class="date-pills">
          <div class="date-pill active">
            <span class="pill-day">Sen</span>
            <span class="pill-date">25</span>
          </div>
          <div class="date-pill">
            <span class="pill-day">Sel</span>
            <span class="pill-date">26</span>
          </div>
          <div class="date-pill">
            <span class="pill-day">Rab</span>
            <span class="pill-date">27</span>
          </div>
          <div class="date-pill">
            <span class="pill-day">Kam</span>
            <span class="pill-date">28</span>
          </div>
        </div>

        <div class="font-bold mt-4 mb-2">Pilih Waktu</div>
        <div class="time-slots">
          <button class="time-slot">10:00</button>
          <button class="time-slot active">11:00</button>
          <button class="time-slot" disabled>13:00</button>
          <button class="time-slot">14:00</button>
          <button class="time-slot">16:30</button>
        </div>

      </div>
      <div class="modal-footer mt-4">
        <button class="btn-terracotta w-100" onclick="closeModal('modalReschedule')">Konfirmasi Jadwal Baru</button>
      </div>
    </div>
  </div>

  <!-- Modal: Cancel Booking -->
  <div class="modal-overlay" id="modalCancelBooking">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Batalkan Janji Temu?</h3>
        <button class="btn-close" onclick="closeModal('modalCancelBooking')">✕</button>
      </div>
      <div class="modal-body">
        <div class="warning-box">
