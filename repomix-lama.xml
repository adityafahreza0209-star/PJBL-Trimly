const { Telegraf } = require('telegraf');
const puppeteer = require('puppeteer-core');

const BOT_TOKEN = '8867014809:AAFyEDzk7nVX0aiuuokrEbXmPw01CHSiIs4';
const MY_TELEGRAM_ID = '8077371239'; // Keamanan agar orang lain tidak bisa akses

const bot = new Telegraf(BOT_TOKEN);

bot.start((ctx) => {
  if (String(ctx.from.id) !== MY_TELEGRAM_ID) return;
  ctx.reply(' Antigravity Controller siap menerima perintah!');
});

// Menangkap semua pesan teks dari HP
bot.on('text', async (ctx) => {
  if (String(ctx.from.id) !== MY_TELEGRAM_ID) {
    return ctx.reply('Akses ditolak.');
  }

  const userPrompt = ctx.message.text;
  await ctx.reply(` Meneruskan instruksi ke Antigravity IDE:\n"${userPrompt}"`);

  try {
    // 1. Hubungkan script ke Antigravity yang terbuka di port 7800
    const browser = await puppeteer.connect({
      browserURL: 'http://127.0.0.1:7800',
      defaultViewport: null
    });

    const pages = await browser.pages();
    const idePage = pages[0]; // Tab utama Antigravity

    // 2. Fokus ke kotak input prompt Antigravity dan ketik perintah
    // Catatan: selector menyesuaikan panel chat Antigravity
    const inputSelector = 'textarea, [contenteditable="true"]';
    await idePage.waitForSelector(inputSelector, { timeout: 5000 });
    
    await idePage.click(inputSelector);
    await idePage.type(inputSelector, userPrompt);
    await idePage.keyboard.press('Enter');

    await ctx.reply(' Perintah berhasil dikirim ke Agent. Sedang diproses di IDE...');

    browser.disconnect();
  } catch (error) {
    console.error(error);
    await ctx.reply(` Gagal mengirim ke IDE: ${error.message}`);
  }
});

bot.launch();
console.log('Bot Telegram aktif dan menunggu perintah dari HP...');
