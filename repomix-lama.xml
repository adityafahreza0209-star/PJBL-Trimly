<file path="ticket.css">
:root {
  --white: #FCFCFC;
  --forest-green: #14221D;
  --terracotta: #D96B43;
  --cool-gray: #F9FAFB;
  --cool-gray-border: #E5E7EB;
  --text-main: #14221D;
  --text-muted: #4B5563;
  --red-soft: #FEE2E2;
  --red-danger: #EF4444;
  --gold: #F59E0B;
  
  --font-serif: 'Playfair Display', serif;
  --font-sans: 'Geist', 'Outfit', sans-serif;
  
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--cool-gray);
  color: var(--text-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  font-family: var(--font-serif);
  font-weight: 600;
  line-height: 1.2;
}

.font-bold { font-weight: 600; }
.text-muted { color: var(--text-muted); font-size: 0.875rem; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 12px; }
.mt-4 { margin-top: 16px; }
.w-100 { width: 100%; }

/* Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background-color: var(--white);
  border-bottom: 1px solid var(--cool-gray-border);
}
.brand-logo {
  font-size: 1.5rem;
  color: var(--forest-green);
}

/* Layout */
.page-container {
  padding: 24px 16px;
  max-width: 1000px;
  margin: 0 auto;
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 768px) {
  .page-container { padding: 48px 24px; }
  .split-grid { grid-template-columns: 1fr 1fr; }
}

/* Digital Pass */
.digital-pass {
  background-color: var(--forest-green);
  color: var(--white);
  border-radius: 20px;
  padding: 32px;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100%;
}
.pass-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40px;
}
.pass-title {
  font-size: 1.75rem;
  letter-spacing: -0.02em;
}
.pass-status {
  background-color: rgba(255,255,255,0.15);
  padding: 4px 12px;
  border-radius: 99px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.pass-body { flex: 1; display: flex; flex-direction: column; }
.pass-client { font-size: 1.5rem; margin-bottom: 4px; }
.pass-service { font-size: 1rem; opacity: 0.8; margin-bottom: 32px; }

.pass-details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
}
.detail-label { display: block; font-size: 0.75rem; opacity: 0.7; margin-bottom: 4px; }
.detail-val { display: block; font-size: 1rem; font-weight: 500; }

.pass-code-container {
  margin-top: auto;
  background-color: var(--white);
  color: var(--forest-green);
  padding: 24px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pass-number {
  font-family: var(--font-sans);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.qr-placeholder {
  width: 64px;
  height: 64px;
}

/* Cards */
.info-column {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.card {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 16px;
  padding: 24px;
  box-shadow: var(--shadow-sm);
}

/* Countdown */
.countdown-timer {
  font-family: var(--font-sans);
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--forest-green);
  letter-spacing: -0.02em;
  margin-bottom: 4px;
  line-height: 1;
}

/* Buttons */
button { font-family: var(--font-sans); cursor: pointer; transition: all 0.2s; }
.btn-primary {
  background-color: var(--forest-green);
  color: var(--white);
  border: none;
  padding: 12px 16px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9375rem;
}
.btn-primary:hover { background-color: #0d1613; }

.btn-terracotta {
  background-color: var(--terracotta);
  color: var(--white);
  border: none;
  padding: 12px 16px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9375rem;
}
.btn-terracotta:hover { background-color: #c05c36; }

.btn-outline {
  background-color: transparent;
  color: var(--forest-green);
  border: 1px solid var(--cool-gray-border);
  padding: 12px 16px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9375rem;
}
.btn-outline:hover { background-color: var(--cool-gray); border-color: var(--forest-green); }

.btn-danger {
  background-color: var(--red-danger);
  color: var(--white);
  border: none;
  padding: 12px 16px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9375rem;
}
.btn-danger:hover { background-color: #dc2626; }

.btn-text-danger {
  background: none;
  border: none;
  color: var(--red-danger);
  padding: 12px 16px;
  font-weight: 600;
  font-size: 0.9375rem;
}
.btn-text-danger:hover { text-decoration: underline; }

.btn-sm { padding: 8px 12px; font-size: 0.875rem; }

/* Review Module */
.star-rating {
  display: flex;
  gap: 8px;
}
.star-icon {
  width: 32px;
  height: 32px;
  color: var(--cool-gray-border);
  cursor: pointer;
  transition: all 0.2s;
}
.star-icon.active {
  color: var(--gold);
  fill: var(--gold);
}

.form-control {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  background-color: var(--white);
  color: var(--text-main);
  box-sizing: border-box;
  transition: border-color 0.2s;
  resize: vertical;
}
.form-control:focus { outline: none; border-color: var(--terracotta); }

/* Modals */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(20, 34, 29, 0.4);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.modal-overlay.active { opacity: 1; visibility: visible; }

.modal-content {
  background-color: var(--white);
  border-radius: 20px;
  padding: 32px;
  width: 100%;
  max-width: 440px;
  box-shadow: var(--shadow-lg);
  transform: translateY(20px) scale(0.95);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 90vh;
  overflow-y: auto;
}
.modal-overlay.active .modal-content { transform: translateY(0) scale(1); }

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
.modal-title { font-size: 1.5rem; color: var(--forest-green); }
.btn-close { background: none; border: none; font-size: 1.5rem; color: var(--text-muted); padding: 4px; line-height: 1; }

.info-rule-box {
  background-color: var(--cool-gray);
  border: 1px solid var(--cool-gray-border);
  padding: 16px;
  border-radius: 8px;
  font-size: 0.875rem;
  color: var(--text-muted);
}

.warning-box {
  background-color: var(--red-soft);
  color: #991B1B;
  padding: 16px;
  border-radius: 8px;
  font-size: 0.875rem;
  border: 1px solid #FECACA;
}

.flex-row { display: flex; gap: 12px; }
.flex-1 { flex: 1; }

.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 8px; }

/* Reschedule Picker */
.date-pills {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.date-pills::-webkit-scrollbar { display: none; }
.date-pill {
  min-width: 64px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 12px;
  padding: 12px 8px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
}
.date-pill.active { background-color: var(--forest-green); color: var(--white); border-color: var(--forest-green); }
.pill-day { display: block; font-size: 0.75rem; margin-bottom: 4px; }
.pill-date { display: block; font-size: 1.25rem; font-weight: 700; }

.time-slots {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.time-slot {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  padding: 12px 0;
  border-radius: 8px;
  font-weight: 600;
  text-align: center;
}
.time-slot.active { background-color: var(--terracotta); color: var(--white); border-color: var(--terracotta); }
.time-slot:disabled { background-color: var(--cool-gray); color: #9CA3AF; cursor: not-allowed; }

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background-color: var(--forest-green);
  color: var(--white);
  padding: 12px 24px;
  border-radius: 99px;
  font-weight: 500;
  box-shadow: var(--shadow-md);
  z-index: 1000;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.toast.show { transform: translateX(-50%) translateY(0); }
