<file path="capster.js">
document.addEventListener('DOMContentLoaded', () => {
  // Duty Toggle Logic
  const dutyToggleBtn = document.getElementById('dutyToggleBtn');
  const statusDot = document.getElementById('statusDot');
  const statusLabel = document.getElementById('statusLabel');
  
  dutyToggleBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isActive = dutyToggleBtn.classList.toggle('active');
    
    if (isActive) {
      statusDot.classList.add('active');
      statusLabel.textContent = 'On Duty';
    } else {
      statusDot.classList.remove('active');
      statusLabel.textContent = 'Off Duty';
    }
  });

  // Profile Header Edit Profile Modal Trigger
  const profileHeader = document.getElementById('profileHeader');
  profileHeader.addEventListener('click', (e) => {
    // Open modal if they click anywhere on header (except toggle)
    if (!e.target.closest('#dutyToggleBtn')) {
      openModal('modalEditProfile');
    }
  });
  
  // Specific Pencil Button trigger
  const btnEditProfileIcon = document.getElementById('btnEditProfileIcon');
  if (btnEditProfileIcon) {
    btnEditProfileIcon.addEventListener('click', (e) => {
      e.stopPropagation();
      openModal('modalEditProfile');
    });
  }

  // Leave Request FAB Trigger
  const btnRequestLeave = document.getElementById('btnRequestLeave');
  btnRequestLeave.addEventListener('click', () => {
    openModal('modalLeaveRequest');
  });
});

// Modal Utilities
function openModal(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) modal.classList.add('active');
}

function closeModal(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) modal.classList.remove('active');
}

// Drawer & Roster Logic
let currentCard = null;

function openAppointmentDrawer(clientName, time, service, status, el) {
  currentCard = el;
  
  // Populate Drawer Data
  document.getElementById('drawerClientName').textContent = clientName;
  document.getElementById('drawerClientTime').textContent = `${time} • ${service}`;
  const statusBadge = document.getElementById('drawerClientStatus');
  statusBadge.textContent = status;
  
  statusBadge.className = 'badge'; 
  if (status === 'DP Paid' || status === 'In Chair') {
    statusBadge.classList.add('badge-green');
  } else if (status === 'Done') {
    statusBadge.classList.add('badge-gray');
  } else {
    statusBadge.classList.add('badge-orange');
  }
  
  const btnStartService = document.getElementById('btnStartService');
  if (status === 'Done') {
    btnStartService.style.display = 'none';
  } else if (status === 'In Chair') {
    btnStartService.style.display = 'block';
    btnStartService.textContent = 'Tandai Selesai / Completed';
    btnStartService.onclick = () => markCompleted();
  } else {
    btnStartService.style.display = 'block';
    btnStartService.textContent = 'Mulai Layanan / In-Chair';
    btnStartService.onclick = () => markInChair();
  }

  const drawer = document.getElementById('bottomDrawerAppointment');
  if (drawer) drawer.classList.add('active');
}

function closeDrawer(drawerId) {
  const drawer = document.getElementById(drawerId);
  if (drawer) drawer.classList.remove('active');
}

function markInChair() {
  if (currentCard) {
    const badge = currentCard.querySelector('.badge');
    badge.textContent = 'In Chair';
    badge.className = 'badge badge-green'; 
    
    const onClickStr = currentCard.getAttribute('onclick');
    currentCard.setAttribute('onclick', onClickStr.replace("'DP Paid'", "'In Chair'"));
  }
  closeDrawer('bottomDrawerAppointment');
}

function markCompleted() {
  if (currentCard) {
    const badge = currentCard.querySelector('.badge');
    badge.textContent = 'Done';
    badge.className = 'badge badge-gray';
    
    const timelineItem = currentCard.closest('.timeline-item');
    timelineItem.classList.add('completed');
    timelineItem.classList.remove('active');
    currentCard.classList.remove('active-card');
    
    const onClickStr = currentCard.getAttribute('onclick');
    currentCard.setAttribute('onclick', onClickStr.replace("'In Chair'", "'Done'"));
  }
  closeDrawer('bottomDrawerAppointment');
}

// Profile Skill Tags Management
function addSkill() {
  const input = document.getElementById('newSkillInput');
  const val = input.value.trim();
  if (val) {
    const container = document.getElementById('skillTagsContainer');
    const span = document.createElement('span');
    span.className = 'skill-tag';
    span.innerHTML = `${val} <button class="remove-tag" onclick="removeTag(this)" aria-label="Remove tag">✕</button>`;
    container.appendChild(span);
    input.value = '';
  }
}

document.getElementById('newSkillInput')?.addEventListener('keypress', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    addSkill();
  }
});

function removeTag(btn) {
  btn.parentElement.remove();
}

function saveProfile() {
  // Simulate saving bio & skills
  console.log('Profile saved');
  closeModal('modalEditProfile');
}
</file>

<file path="dashboard.css">
:root {
  --white: #FFFFFF;
  --cool-gray: #F9FAFB;
  --cool-gray-hover: #F3F4F6;
  --cool-gray-border: #E5E7EB;
  
  --forest-green: #14221D;
  --forest-green-muted: #4B5563;
  --forest-green-light: #9CA3AF;
  
  --terracotta: #D96B43;
  --terracotta-soft: #FDE8E1;
  --success-green: #10B981;
  --success-soft: #D1FAE5;
  --red-alert: #EF4444;
  
  --font-sans: 'Outfit', sans-serif;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background-color: var(--cool-gray);
  color: var(--forest-green-muted);
  font-family: var(--font-sans);
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
}

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.text-dark { color: var(--forest-green); }
.text-muted { color: var(--forest-green-muted); }
.text-sm { font-size: 0.875rem; }
.text-xs { font-size: 0.75rem; }
.text-lg { font-size: 1.25rem; }
.uppercase { text-transform: uppercase; letter-spacing: 0.05em; }
.text-red { color: var(--red-alert); }

.pos-layout {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* Sidebar */
.pos-sidebar {
  width: 72px;
  background-color: var(--forest-green);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  box-shadow: 2px 0 10px rgba(0,0,0,0.05);
  z-index: 50;
}

.sidebar-brand {
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.brand-monogram {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 500;
  color: var(--white);
  line-height: 1;
}

.brand-monogram span {
  color: var(--terracotta);
}

.sidebar-nav {
  flex: 1;
  padding: 32px 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: 100%;
  align-items: center;
  overflow: visible; /* Ensure tooltip is not clipped */
}

.nav-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  transition: all 0.2s;
  position: relative;
}

.nav-icon svg {
  width: 22px;
  height: 22px;
}

.nav-icon:hover {
  color: var(--white);
}

.nav-icon.active {
  color: var(--terracotta);
  background-color: rgba(217, 107, 67, 0.1);
}

/* Floating Tooltip */
.nav-icon::after {
  content: attr(data-tooltip);
  position: absolute;
  left: calc(100% + 14px);
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--forest-green);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--white);
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 500;
  padding: 6px 12px;
  border-radius: 6px;
  white-space: nowrap;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 100;
}

/* Tooltip Caret (Triangle) */
.nav-icon::before {
  content: "";
  position: absolute;
  left: calc(100% + 9px); /* Position overlapping the border */
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 8px;
  height: 8px;
  background-color: var(--forest-green);
  border-left: 1px solid rgba(255, 255, 255, 0.15);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 101;
}

/* Inner Caret for background color */
.nav-icon:hover::after,
.nav-icon:hover::before {
  opacity: 1;
  visibility: visible;
}

.sidebar-footer {
  padding: 24px 0;
  width: 100%;
  display: flex;
  justify-content: center;
}

.avatar-mini {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--white);
  color: var(--forest-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-weight: 600;
  font-size: 1.1rem;
  border: 2px solid rgba(255,255,255,0.2);
  background-clip: padding-box;
}

/* Main Area */
.pos-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Topbar */
.pos-topbar {
  height: 70px;
  background-color: var(--white);
  border-bottom: 1px solid var(--cool-gray-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  flex-shrink: 0;
}

.studio-title {
  font-size: 1.25rem;
  margin-bottom: 2px;
  color: var(--forest-green);
}

.current-date {
  font-size: 0.85rem;
  color: var(--forest-green-muted);
}

.emergency-toggle {
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: #FEF2F2;
  border: 1px solid #FECACA;
  padding: 8px 16px;
  border-radius: 8px;
}

.toggle-switch {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  background-color: var(--cool-gray-border);
  border: none;
  position: relative;
  cursor: pointer;
  transition: all 0.2s;
}
.red-toggle { background-color: #FCA5A5; }
.toggle-knob {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background-color: var(--white);
  transition: transform 0.2s;
  box-shadow: var(--shadow-sm);
}

/* Content */
.pos-content {
  flex: 1;
  padding: 32px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* KPIs */
.kpi-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.kpi-card {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 12px;
  padding: 24px;
  box-shadow: var(--shadow-card);
}

.kpi-value {
  font-size: 2rem;
  font-weight: 700;
  margin-top: 8px;
}

/* Matrix */
.schedule-section {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 12px;
  padding: 24px;
  box-shadow: var(--shadow-card);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.legend-row {
  display: flex;
  gap: 16px;
  font-size: 0.85rem;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.dot.dp-paid { background-color: var(--terracotta); }
.dot.completed { background-color: var(--success-green); }

/* Canvas */
.matrix-canvas {
  flex: 1;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  overflow: hidden;
}

.matrix-time-header {
  display: flex;
  height: 48px;
  background-color: var(--cool-gray);
  border-bottom: 1px solid var(--cool-gray-border);
}

.capster-spacer {
  width: 160px;
  border-right: 1px solid var(--cool-gray-border);
  flex-shrink: 0;
}

.time-slots {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.time-tick {
  padding-left: 12px;
  padding-top: 14px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--forest-green-muted);
  border-right: 1px solid var(--cool-gray-border);
}
.time-tick:last-child { border-right: none; }

.matrix-body {
  display: flex;
  flex-direction: column;
}

.matrix-row {
  display: flex;
  height: 80px;
  border-bottom: 1px solid var(--cool-gray-border);
}
.matrix-row:last-child { border-bottom: none; }

.capster-cell {
  width: 160px;
  border-right: 1px solid var(--cool-gray-border);
  padding: 16px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.timeline-track {
  flex: 1;
  position: relative;
}

.grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  pointer-events: none;
}
.grid-lines span {
  border-right: 1px solid var(--cool-gray-border);
}
.grid-lines span:last-child { border-right: none; }

.appt-block {
  position: absolute;
  top: 12px;
  height: 56px;
  border-radius: 6px;
  padding: 8px 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 10;
  border: 1px solid transparent;
}

.appt-block.completed {
  background-color: var(--success-soft);
  border-color: #A7F3D0;
  color: #065F46;
}

.appt-block.dp-paid {
  background-color: var(--terracotta-soft);
  border-color: #F8B4A0;
  color: #9A3412;
}

.appt-name { font-size: 0.85rem; margin-bottom: 2px; }
.appt-service { font-size: 0.75rem; opacity: 0.8; }
/* ==================== LEAVE REQUESTS WIDGET ==================== */
.leave-requests-widget {
  background-color: var(--white);
  border: 1px solid var(--cool-gray-border);
  border-radius: 12px;
  box-shadow: var(--shadow-card);
  padding: 24px;
}

.widget-header {
  margin-bottom: 16px;
}

.widget-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  color: var(--forest-green);
}

.leave-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.leave-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  background-color: var(--cool-gray);
}

.leave-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.leave-actions {
  display: flex;
  gap: 8px;
}

.btn-icon {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  background-color: var(--white);
}

.btn-approve {
  border-color: var(--success-green);
  color: var(--success-green);
}
.btn-approve:hover {
  background-color: var(--success-soft);
}

.btn-reject {
  border-color: var(--red-alert);
  color: var(--red-alert);
}
.btn-reject:hover {
  background-color: #FEE2E2;
}

/* ==================== APPT BLOCK ==================== */
.appt-block {
  cursor: pointer;
  transition: transform 0.1s, box-shadow 0.1s;
}
.appt-block:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-card);
}

/* ==================== MODAL ==================== */
.modal-backdrop {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background-color: rgba(20, 34, 29, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}

.modal-backdrop.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  background-color: var(--white);
  border-radius: 12px;
  width: 100%;
  max-width: 480px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  transform: scale(0.95);
  transition: transform 0.2s;
  overflow: hidden;
}

.modal-backdrop.active .modal-card {
  transform: scale(1);
}

.modal-header {
  padding: 24px;
  border-bottom: 1px solid var(--cool-gray-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--forest-green);
}

.status-badge {
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
}
.status-badge.dp-badge {
  background-color: var(--terracotta-soft);
  color: #9A3412;
}

.modal-body {
  padding: 24px;
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--cool-gray-border);
  padding-bottom: 16px;
}
.data-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.data-label {
  color: var(--forest-green-muted);
  font-size: 0.875rem;
}
.data-value {
  color: var(--forest-green);
}

.modal-footer {
  padding: 24px;
  background-color: var(--cool-gray);
  border-top: 1px solid var(--cool-gray-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-cancel-text {
  background: none;
  border: none;
  color: var(--red-alert);
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
}
.btn-cancel-text:hover {
  text-decoration: underline;
}

.action-right {
  display: flex;
  gap: 12px;
}

.btn-outline, .btn-outline-primary {
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 500;
  cursor: pointer;
  background-color: var(--white);
  transition: all 0.2s;
  font-size: 0.875rem;
}

.btn-outline {
  border: 1px solid var(--cool-gray-border);
  color: var(--forest-green);
}
.btn-outline:hover {
  background-color: var(--cool-gray-hover);
}

.btn-outline-primary {
  border: 1px solid var(--forest-green);
  color: var(--forest-green);
}
.btn-outline-primary:hover {
  background-color: var(--forest-green);
  color: var(--white);
}
