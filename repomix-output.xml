  height: 64px;
  background-color: rgba(217, 107, 67, 0.1);
  color: var(--terracotta);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ticket-sub {
  font-size: 0.85rem;
  color: rgba(20, 34, 29, 0.7);
  margin-top: 0.5rem;
  margin-bottom: 2rem;
}

.digital-pass {
  width: 100%;
  background-color: var(--bg-cool-gray);
  border: 1px dashed var(--border-medium);
  border-radius: var(--radius-sm);
  padding: 1.5rem;
  margin-bottom: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.pass-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
}

.pass-row span:first-child {
  color: rgba(20, 34, 29, 0.6);
}

.pass-divider {
  height: 1px;
  background-color: var(--border-light);
  margin: 0.5rem 0;
}

.btn-done {
  width: 100%;
  padding: 1rem;
  background-color: var(--bg-arch-white);
  color: var(--forest-green);
  border: 1.5px solid var(--forest-green);
  border-radius: var(--radius-sm);
  font-weight: 600;
  cursor: pointer;
}

/* ==================== DESKTOP SPLIT-GRID ==================== */
@media (min-width: 1024px) {
  .booking-canvas {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 2rem;
    flex-direction: row;
    display: grid;
    grid-template-columns: 6.5fr 3.5fr;
    gap: 4rem;
  }

  .booking-flow {
    padding: 0;
  }
  
  .mobile-bottom-spacer {
    display: none;
  }

  /* Right Column fully expands and holds sticky card */
  .booking-summary {
    position: relative; /* Release from fixed bottom */
    width: 100%;
  }

  .sticky-summary-card {
    position: sticky;
    top: 3rem;
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-card);
  }

  /* Reveal detailed summary on Desktop */
  .summary-header, .summary-details, .dp-disclaimer {
    display: flex;
    flex-direction: column;
  }

  .summary-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(252, 252, 252, 0.15);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .summary-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .trimly-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: rgba(252, 252, 252, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .summary-details {
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(252, 252, 252, 0.15);
    padding-bottom: 2.5rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .s-label {
    font-size: 0.85rem;
    color: rgba(252, 252, 252, 0.7);
  }

  .s-val-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .s-sub {
    font-size: 0.75rem;
    color: rgba(252, 252, 252, 0.5);
    margin-top: 0.25rem;
  }

  .summary-totals {
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .total-row {
    color: rgba(252, 252, 252, 0.8);
  }
  
  .dp-row {
    font-size: 1.25rem;
    margin-top: 0.5rem;
  }

  .dp-disclaimer {
    font-size: 0.8rem;
    color: rgba(252, 252, 252, 0.6);
    margin-top: 1rem;
  }

  /* Modals on desktop */
  .payment-drawer {
    width: 480px;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem; /* Float instead of sticky bottom */
  }
}

/* History Drawer Specifics */
.history-drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 440px;
  background: var(--bg-arch-white);
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  box-shadow: -10px 0 30px rgba(0,0,0,0.1);
}
.modal-backdrop.active .history-drawer {
  transform: translateX(0);
