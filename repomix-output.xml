<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Capster Dashboard - Trimly</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="capster.css">
  <script src="capster.js" defer></script>
</head>
<body>
  <div class="capster-app-frame">
    <div class="app-content">
      <header class="capster-header" id="profileHeader" role="button" aria-label="Edit Profile" tabindex="0">
        <div class="profile-group">
          <div class="avatar-wrap">
            <img src="https://ui-avatars.com/api/?name=Fajar+A&background=14221D&color=fff&size=100" alt="Fajar A." class="avatar-img" id="displayAvatar">
          </div>
          <div class="profile-info">
            <div class="name-row">
              <h1 class="capster-name" id="displayName">Fajar Adiputra</h1>
              <button id="btnEditProfileIcon" class="btn-icon" aria-label="Edit Profile">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
              </button>
            </div>
            <div class="status-toggle-group">
              <span class="status-dot active" id="statusDot"></span>
              <span class="status-label font-medium" id="statusLabel">On Duty</span>
              <button class="toggle-switch active" id="dutyToggleBtn" aria-label="Toggle Duty Status">
                <span class="toggle-knob"></span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main class="capster-main-content">
        <section class="metrics-card">
          <div class="metric-block">
            <div class="metric-label font-medium">Total Komisi Hari Ini</div>
            <div class="metric-value">Rp 450.000</div>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-block align-right">
            <div class="metric-label font-medium">Jumlah Selesai</div>
            <div class="metric-value cuts-value">6 Cuts</div>
          </div>
        </section>

        <section class="roster-section">
          <h2 class="section-title" style="font-family: var(--font-serif);">Today's Roster</h2>
          <div class="timeline-container">
            
            <div class="timeline-item completed">
              <div class="time-col">
                <span class="time-text font-bold">10:00</span>
