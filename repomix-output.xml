  font-weight: 700;
  font-size: 1.15rem;
  border-radius: 4px;
}

.brand-name {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.brand-dot {
  color: var(--terracotta);
}

.nav-links {
  display: flex;
  gap: 1.75rem;
}

.nav-item {
  font-size: 0.9rem;
  font-weight: 500;
  color: rgba(20, 34, 29, 0.75);
}

.nav-item:hover {
  color: var(--forest-green);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 1.25rem;
