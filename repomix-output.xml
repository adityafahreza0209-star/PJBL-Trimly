}

.leave-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border: 1px solid var(--cool-gray-border);
  border-radius: 8px;
  background-color: var(--cool-gray);
}

.leave-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.leave-actions {
  display: flex;
  gap: 8px;
}

.btn-icon {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  background-color: var(--white);
}

.btn-approve {
  border-color: var(--success-green);
  color: var(--success-green);
}
.btn-approve:hover {
  background-color: var(--success-soft);
}

.btn-reject {
  border-color: var(--red-alert);
  color: var(--red-alert);
}
.btn-reject:hover {
  background-color: #FEE2E2;
}

/* ==================== APPT BLOCK ==================== */
.appt-block {
  cursor: pointer;
  transition: transform 0.1s, box-shadow 0.1s;
}
.appt-block:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-card);
}

/* ==================== MODAL ==================== */
.modal-backdrop {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background-color: rgba(20, 34, 29, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}

.modal-backdrop.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  background-color: var(--white);
  border-radius: 12px;
  width: 100%;
  max-width: 480px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  transform: scale(0.95);
  transition: transform 0.2s;
  overflow: hidden;
}

.modal-backdrop.active .modal-card {
  transform: scale(1);
}

.modal-header {
  padding: 24px;
  border-bottom: 1px solid var(--cool-gray-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--forest-green);
}

.status-badge {
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
}
.status-badge.dp-badge {
  background-color: var(--terracotta-soft);
  color: #9A3412;
}

.modal-body {
  padding: 24px;
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--cool-gray-border);
  padding-bottom: 16px;
}
.data-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.data-label {
  color: var(--forest-green-muted);
  font-size: 0.875rem;
}
.data-value {
  color: var(--forest-green);
}

.modal-footer {
  padding: 24px;
  background-color: var(--cool-gray);
  border-top: 1px solid var(--cool-gray-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-cancel-text {
  background: none;
  border: none;
  color: var(--red-alert);
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
}
.btn-cancel-text:hover {
  text-decoration: underline;
}

.action-right {
  display: flex;
  gap: 12px;
}

.btn-outline, .btn-outline-primary {
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 500;
  cursor: pointer;
  background-color: var(--white);
  transition: all 0.2s;
  font-size: 0.875rem;
}

.btn-outline {
  border: 1px solid var(--cool-gray-border);
  color: var(--forest-green);
}
.btn-outline:hover {
  background-color: var(--cool-gray-hover);
}

.btn-outline-primary {
  border: 1px solid var(--forest-green);
  color: var(--forest-green);
}
.btn-outline-primary:hover {
  background-color: var(--forest-green);
  color: var(--white);
}
