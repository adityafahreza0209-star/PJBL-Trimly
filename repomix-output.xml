<file path="dashboard.css">
:root {
  --white: #FFFFFF;
  --cool-gray: #F9FAFB;
  --cool-gray-hover: #F3F4F6;
  --cool-gray-border: #E5E7EB;
  
  --forest-green: #14221D;
  --forest-green-muted: #4B5563;
  --forest-green-light: #9CA3AF;
  
  --terracotta: #D96B43;
  --terracotta-soft: #FDE8E1;
  --success-green: #10B981;
  --success-soft: #D1FAE5;
  --red-alert: #EF4444;
  
  --font-sans: 'Outfit', sans-serif;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background-color: var(--cool-gray);
  color: var(--forest-green-muted);
  font-family: var(--font-sans);
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
}

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.text-dark { color: var(--forest-green); }
.text-muted { color: var(--forest-green-muted); }
.text-sm { font-size: 0.875rem; }
.text-xs { font-size: 0.75rem; }
.text-lg { font-size: 1.25rem; }
.uppercase { text-transform: uppercase; letter-spacing: 0.05em; }
.text-red { color: var(--red-alert); }

.pos-layout {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* Sidebar */
.pos-sidebar {
  width: 72px;
  background-color: var(--forest-green);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  box-shadow: 2px 0 10px rgba(0,0,0,0.05);
  z-index: 50;
}

.sidebar-brand {
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.brand-monogram {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 500;
  color: var(--white);
  line-height: 1;
}

.brand-monogram span {
  color: var(--terracotta);
}

.sidebar-nav {
  flex: 1;
  padding: 32px 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: 100%;
  align-items: center;
  overflow: visible; /* Ensure tooltip is not clipped */
}

.nav-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  transition: all 0.2s;
  position: relative;
}

.nav-icon svg {
  width: 22px;
  height: 22px;
}

.nav-icon:hover {
  color: var(--white);
}

.nav-icon.active {
  color: var(--terracotta);
  background-color: rgba(217, 107, 67, 0.1);
}

/* Floating Tooltip */
.nav-icon::after {
  content: attr(data-tooltip);
  position: absolute;
  left: calc(100% + 14px);
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--forest-green);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--white);
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 500;
  padding: 6px 12px;
  border-radius: 6px;
  white-space: nowrap;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 100;
}

/* Tooltip Caret (Triangle) */
.nav-icon::before {
  content: "";
  position: absolute;
  left: calc(100% + 9px); /* Position overlapping the border */
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 8px;
  height: 8px;
  background-color: var(--forest-green);
  border-left: 1px solid rgba(255, 255, 255, 0.15);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 101;
}

/* Inner Caret for background color */
.nav-icon:hover::after,
.nav-icon:hover::before {
  opacity: 1;
  visibility: visible;
}

.sidebar-footer {
  padding: 24px 0;
  width: 100%;
  display: flex;
  justify-content: center;
}

.avatar-mini {
  width: 40px;
