  gap: 8px;
  background-color: transparent;
  color: var(--forest-green);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-sm);
  border: 1.5px solid var(--forest-green);
