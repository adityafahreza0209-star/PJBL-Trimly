<file path="portal.css">
/* ==========================================================================
   TRIMLY OS — Booking Portal
   Aesthetic: Light Editorial / Luxury Magazine
   Layout: Responsive Split-Grid (Desktop) / Sticky Bottom Bar (Mobile)
   ========================================================================== */

:root {
  /* Strict Palette */
  --bg-arch-white: #FCFCFC;
  --bg-cool-gray: #F9FAFB;
  --forest-green: #14221D;
  --forest-green-light: #1e332c;
  --terracotta: #D96B43;
  --terracotta-hover: #c55b34;
  
  --border-light: rgba(20, 34, 29, 0.12);
  --border-medium: rgba(20, 34, 29, 0.25);
  
  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
  
  /* Layout */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  
  --shadow-subtle: 0 4px 20px -2px rgba(20, 34, 29, 0.05);
  --shadow-float: 0 -8px 30px rgba(20, 34, 29, 0.1);
  --shadow-modal: 0 24px 50px rgba(20, 34, 29, 0.2);
  
  --transition-fast: 0.2s ease;
}

/* Base Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  background-color: var(--bg-arch-white);
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  color: var(--forest-green);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  text-decoration: none;
  color: inherit;
}

img, svg {
  max-width: 100%;
  display: block;
}

.font-bold {
  font-weight: 600;
}

.text-terracotta {
  color: var(--terracotta);
}

.text-center {
  text-align: center;
}

.mt-4 { margin-top: 1rem; }
.mt-section { margin-top: 3.5rem; }

/* ==================== LAYOUT (SPLIT GRID) ==================== */
.booking-canvas {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.booking-flow {
  width: 100%;
  padding: 1.5rem;
}

/* Tenant Header */
.tenant-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 3rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-light);
}

.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid var(--border-light);
  border-radius: 50%;
  transition: all var(--transition-fast);
}

.btn-back:hover {
  background-color: var(--bg-cool-gray);
  border-color: var(--border-medium);
}

.tenant-identity {
  display: flex;
  flex-direction: column;
}

.tenant-title {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.1;
}

.tenant-location {
  font-size: 0.85rem;
  color: rgba(20, 34, 29, 0.7);
}

/* Step Headings */
.step-heading {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  color: var(--forest-green);
}

/* ==================== CAPSTER GRID ==================== */
.capster-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem;
}

.capster-card {
  cursor: pointer;
}

.capster-card input {
  display: none;
}

.capster-card-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.5rem 1rem;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
  background-color: var(--bg-arch-white);
}

.capster-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: var(--bg-cool-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: 1.25rem;
  margin-bottom: 1rem;
  color: var(--forest-green);
  border: 1px solid var(--border-light);
}

.capster-info {
  text-align: center;
}

.capster-role {
  font-size: 0.75rem;
  color: rgba(20, 34, 29, 0.6);
  margin-top: 0.25rem;
}

.capster-card input:checked + .capster-card-inner {
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
  background-color: var(--bg-cool-gray);
}

.capster-card:hover .capster-card-inner {
  border-color: var(--border-medium);
}

/* ==================== SERVICE LIST ==================== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.service-item {
  cursor: pointer;
}

.service-item input {
  display: none;
}

.service-item-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1.5rem;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
  background-color: var(--bg-arch-white);
}

.service-name {
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.service-desc {
  font-size: 0.85rem;
  color: rgba(20, 34, 29, 0.7);
  margin-bottom: 0.75rem;
  max-width: 90%;
}

.service-meta {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--terracotta);
  background-color: rgba(217, 107, 67, 0.1);
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
}

.service-price {
  font-size: 1.1rem;
  white-space: nowrap;
}

.service-item input:checked + .service-item-inner {
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
  background-color: var(--bg-cool-gray);
}

/* ==================== DATE & TIME ==================== */
.date-scroll-container {
  width: 100%;
  overflow-x: auto;
  padding-bottom: 1rem;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
}

.date-scroll-container::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.date-pills {
  display: flex;
  gap: 0.75rem;
}

.date-pill {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.25rem;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.date-day {
  font-size: 0.75rem;
  text-transform: uppercase;
  color: rgba(20, 34, 29, 0.6);
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.date-num {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1;
}

.date-pill.active {
  background-color: var(--forest-green);
  border-color: var(--forest-green);
  color: var(--bg-arch-white);
}

.date-pill.active .date-day {
  color: rgba(252, 252, 252, 0.8);
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.time-btn {
  background: var(--bg-arch-white);
  border: 1px solid var(--border-light);
  padding: 0.75rem 0;
  border-radius: var(--radius-sm);
  font-weight: 500;
  font-size: 0.9rem;
  color: var(--forest-green);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.time-btn:not(:disabled):hover {
  border-color: var(--forest-green);
}

.time-btn.active {
  background-color: var(--forest-green);
  border-color: var(--forest-green);
  color: var(--bg-arch-white);
}

.time-btn:disabled {
  background-color: var(--bg-cool-gray);
  color: rgba(20, 34, 29, 0.3);
  text-decoration: line-through;
  cursor: not-allowed;
}

/* ==================== CLIENT DETAILS FORM ==================== */
.client-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-size: 0.85rem;
}

.form-input {
  width: 100%;
  padding: 1rem;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  background-color: var(--bg-arch-white);
  color: var(--forest-green);
  font-family: inherit;
  font-size: 1rem;
  transition: border-color var(--transition-fast);
}

.form-input:focus {
  outline: none;
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
}

/* ==================== ORDER SUMMARY ==================== */
.booking-summary {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 50;
}

.sticky-summary-card {
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  padding: 1.25rem 1.5rem;
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  box-shadow: var(--shadow-float);
}

.summary-header, .summary-details {
  display: none; /* Hidden on mobile by default to save space */
}

.summary-totals {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  margin-bottom: 1rem;
}

.total-row, .dp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
}

.dp-row {
  font-size: 1.1rem;
}

.dp-disclaimer {
  display: none; /* Hidden on mobile */
}

.btn-checkout {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  background-color: var(--bg-arch-white);
  color: var(--forest-green);
  font-weight: 600;
  font-size: 1rem;
  padding: 1rem;
  border-radius: var(--radius-sm);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-checkout:disabled {
  background-color: rgba(252, 252, 252, 0.5);
  cursor: not-allowed;
}

.mobile-bottom-spacer {
  height: 220px; /* Increased space to prevent overlapping with the sticky bottom bar */
}

/* ==================== MODALS ==================== */
.modal-backdrop {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background-color: rgba(10, 10, 10, 0.6);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 200;
  display: flex;
  align-items: flex-end; /* Drawer style */
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-fast);
}

.modal-backdrop.active {
  opacity: 1;
  pointer-events: auto;
}

.payment-drawer {
  width: 100%;
  background-color: var(--bg-arch-white);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  padding-bottom: 2rem;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.modal-backdrop.active .payment-drawer {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid var(--border-light);
  flex-shrink: 0; /* Keep header sticky */
}

.btn-close-modal {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--forest-green);
}

.drawer-body {
  padding: 1.5rem;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.payment-timer {
  background-color: rgba(217, 107, 67, 0.1);
  padding: 0.75rem;
  border-radius: var(--radius-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
  margin-bottom: 1.5rem;
}

.merchant-info {
  margin-bottom: 2rem;
}

.dp-amount-display {
  font-size: 2rem;
  font-family: var(--font-serif);
  margin-top: 0.5rem;
}

.method-btn {
  padding: 1rem;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  margin-bottom: 0.75rem;
  cursor: pointer;
  font-weight: 500;
  font-size: 0.9rem;
  transition: all var(--transition-fast);
}

.method-btn.active {
  border-color: var(--forest-green);
  box-shadow: 0 0 0 1px var(--forest-green);
  background-color: var(--bg-cool-gray);
}

.qris-simulator {
  display: flex;
  justify-content: center;
  margin: 2rem 0;
}

.qris-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  border: 1px dashed var(--border-medium);
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  color: rgba(20, 34, 29, 0.6);
}

.btn-simulate-pay {
  width: 100%;
  padding: 1rem;
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  border: none;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
}

/* Success Ticket Modal */
#ticketModal {
  align-items: center; /* Center horizontally/vertically */
}

.ticket-card {
  width: 90%;
  max-width: 400px;
  background-color: var(--bg-arch-white);
  border-radius: var(--radius-lg);
  padding: 2.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0.95);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 95vh;
  overflow-y: auto;
