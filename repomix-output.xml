<file path="style.css">
/* ==========================================================================
   TRIMLY — B2B SaaS Landing Page
   Aesthetic: Light Editorial / Luxury Magazine
   ========================================================================== */

:root {
  /* Strict Color Palette */
  --bg-arch-white: #FCFCFC;
  --bg-cool-gray: #F9FAFB;
  --forest-green: #14221D;
  --forest-green-light: #1e332c;
  --forest-green-surface: #243d34;
  --terracotta: #D96B43;
  --terracotta-hover: #c55b34;
  
  --border-light: rgba(20, 34, 29, 0.1);
  --border-medium: rgba(20, 34, 29, 0.22);
  --border-dark: #14221D;

  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
  
  /* Layout */
  --container-max: 1200px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  
  /* Shadows */
  --shadow-subtle: 0 4px 20px -2px rgba(20, 34, 29, 0.05);
  --shadow-card: 0 12px 32px -8px rgba(20, 34, 29, 0.08);
  --shadow-mockup: 0 20px 45px -12px rgba(20, 34, 29, 0.18);
  
  --transition-fast: 0.2s ease;
}

/* Base Styles */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--bg-arch-white);
}

body {
  font-family: var(--font-sans);
  color: var(--forest-green);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition-fast);
}

img, svg {
  max-width: 100%;
  display: block;
}

.font-bold {
  font-weight: 600;
}

.text-terracotta {
  color: var(--terracotta);
}

.text-center {
  text-align: center;
}

.mt-8 {
  margin-top: 2rem;
}

.full-width {
  width: 100%;
  justify-content: center;
}

/* Layout Containers */
.section-container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 2rem;
}

/* Typography Scale (Strict Hierarchy) */
h1, h2, h3 {
  font-family: var(--font-serif);
  font-weight: 500;
  line-height: 1.1;
  color: var(--forest-green);
}

.hero-headline {
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}

.section-heading {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  letter-spacing: -0.01em;
  margin-bottom: 3rem;
  max-width: 800px;
}

.section-heading.text-center {
  margin-left: auto;
  margin-right: auto;
}

.feature-title, .tier-name, .step-title {
  font-size: 1.4rem;
  margin-bottom: 0.75rem;
}

.hero-subtext, .roi-desc, .faq-desc {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  color: rgba(20, 34, 29, 0.75);
  margin-bottom: 2rem;
}

/* ==================== BUTTONS (STRICT CONTRAST) ==================== */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  font-weight: 600;
