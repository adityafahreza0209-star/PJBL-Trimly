.hero-cta-group {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* ==================== HERO MOCKUP (TIGHTENED & LEGIBLE) ==================== */
.dashboard-mockup {
  background-color: var(--bg-cool-gray);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
