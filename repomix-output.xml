/* ==================== HERO B2B ==================== */
.hero-b2b {
  padding: 5rem 0;
  background-color: var(--bg-arch-white);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
  align-items: center;
