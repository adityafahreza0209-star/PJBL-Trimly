  margin-bottom: 1.5rem;
}

.feature-desc {
  color: rgba(20, 34, 29, 0.75);
}

/* ==================== 3-STEP WORKFLOW STEPPER ==================== */
.workflow-section {
  padding: 6rem 0;
  background-color: var(--bg-arch-white);
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
}

.workflow-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}

.workflow-card {
  padding: 2.5rem;
  background-color: var(--bg-cool-gray);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  display: flex;
  flex-direction: column;
  position: relative;
}

.step-numeral {
  font-family: var(--font-serif);
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--terracotta);
  line-height: 1;
  margin-bottom: 1.25rem;
}

.step-desc {
  color: rgba(20, 34, 29, 0.75);
  font-size: 0.95rem;
}

.step-desc code {
  background-color: rgba(20, 34, 29, 0.08);
  padding: 2px 5px;
  border-radius: 3px;
  font-family: inherit;
  font-weight: 600;
}

/* ==================== ROI CALCULATOR ==================== */
.roi-section {
  padding: 7rem 0;
  background-color: var(--bg-arch-white);
}

.roi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.roi-calculator-card {
  background-color: var(--bg-cool-gray);
  padding: 2.75rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-card);
}

.calc-group {
  margin-bottom: 1.75rem;
}

.calc-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.calc-val {
  font-weight: 600;
  color: var(--terracotta);
}

/* Custom Slider */
.trimly-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  background: var(--border-medium);
  border-radius: 3px;
  outline: none;
}

.trimly-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--forest-green);
  cursor: pointer;
  border: 2px solid var(--bg-arch-white);
  box-shadow: 0 2px 5px rgba(0,0,0,0.25);
}

.calc-result-box {
  margin-top: 2.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-medium);
}

.result-label {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.result-value {
  font-size: 2.4rem;
  font-family: var(--font-serif);
  font-weight: 700;
  color: var(--terracotta);
  margin-bottom: 0.35rem;
}

.result-subtext {
  font-size: 0.82rem;
  color: rgba(20, 34, 29, 0.65);
}

/* ==================== PRICING ==================== */
.pricing-section {
  padding: 7rem 0;
  background-color: var(--bg-cool-gray);
}

.billing-toggle-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  margin-bottom: 3.5rem;
}

.toggle-label {
  font-weight: 600;
  color: rgba(20, 34, 29, 0.5);
  cursor: pointer;
  transition: color var(--transition-fast);
}

.toggle-label.active {
  color: var(--forest-green);
}

.save-badge {
  background-color: rgba(217, 107, 67, 0.12);
  color: var(--terracotta);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  font-weight: 700;
  margin-left: 8px;
}

.billing-toggle {
  width: 54px;
  height: 30px;
  background-color: var(--forest-green);
  border-radius: 15px;
  border: none;
  position: relative;
  cursor: pointer;
  padding: 3px;
}

.toggle-knob {
  display: block;
  width: 24px;
  height: 24px;
  background-color: var(--bg-arch-white);
  border-radius: 50%;
  transition: transform var(--transition-fast);
  transform: translateX(24px); /* Default active state (Annually) */
}

.billing-toggle[aria-pressed="true"] .toggle-knob {
  transform: translateX(0); /* Monthly */
}

.pricing-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  max-width: 920px;
  margin: 0 auto;
}

.pricing-card {
  background-color: var(--bg-arch-white);
  padding: 3rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-card);
  position: relative;
  display: flex;
  flex-direction: column;
}

.pricing-card.popular {
  border: 2px solid var(--terracotta);
}

.popular-badge {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--terracotta);
  color: var(--bg-arch-white);
  padding: 4px 16px;
  border-radius: 12px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.tier-desc {
  color: rgba(20, 34, 29, 0.75);
  min-height: 3rem;
  margin-bottom: 1.5rem;
}

.tier-price {
  font-family: var(--font-serif);
  display: flex;
  align-items: flex-start;
  gap: 4px;
  margin-bottom: 0.25rem;
}

.tier-price .currency {
  font-size: 1.25rem;
  margin-top: 0.5rem;
}

.tier-price .amount {
  font-size: 2.8rem;
  font-weight: 700;
}

.tier-price .period {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: rgba(20, 34, 29, 0.55);
  margin-top: 1.4rem;
}

.tier-billing-note {
  font-size: 0.82rem;
  color: rgba(20, 34, 29, 0.6);
  margin-bottom: 2rem;
}

.feature-list {
  list-style: none;
  margin-top: 2rem;
}

.feature-list li {
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border-light);
  font-size: 0.92rem;
}

.feature-list li:last-child {
  border-bottom: none;
}

/* ==================== FAQ ==================== */
.faq-section {
  padding: 7rem 0;
  background-color: var(--bg-arch-white);
}

.faq-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 4rem;
}

.faq-accordion {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1px solid var(--border-light);
}

.faq-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 0;
  background: none;
  border: none;
  color: var(--forest-green);
  font-size: 1.1rem;
  font-family: var(--font-sans);
  cursor: pointer;
  text-align: left;
}

.faq-icon {
  font-size: 1.4rem;
  color: var(--terracotta);
  transition: transform var(--transition-fast);
}

.faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-fast);
  color: rgba(20, 34, 29, 0.75);
}

.faq-item.active .faq-content {
  max-height: 220px;
  padding-bottom: 1.5rem;
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
}

/* ==================== FOOTER ==================== */
.b2b-footer {
  background-color: var(--forest-green);
  color: var(--bg-arch-white);
  padding: 5rem 0 2rem;
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 4rem;
  margin-bottom: 4rem;
}

.footer-brand-col .brand-name {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.footer-brand-col p {
  color: rgba(252, 252, 252, 0.75);
  max-width: 300px;
}

.footer-links-col {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.footer-links-col a {
  color: rgba(252, 252, 252, 0.75);
  font-size: 0.92rem;
}

.footer-links-col a:hover {
  color: var(--bg-arch-white);
}

.footer-bottom {
  border-top: 1px solid rgba(252, 252, 252, 0.12);
  padding-top: 2rem;
  text-align: center;
  color: rgba(252, 252, 252, 0.55);
  font-size: 0.85rem;
}

/* ==================== RESPONSIVE ==================== */
@media (max-width: 1024px) {
  .hero-grid, .faq-grid {
    grid-template-columns: 1fr;
  }
  
  .roi-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  
  .workflow-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .nav-links {
    display: none;
  }
  
  .features-grid, .pricing-grid {
    grid-template-columns: 1fr;
  }
  
  .footer-top {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
